# Public business settings
ATG_SITE_URL=https://aitoolgems.tech
ATG_WHATSAPP_NUMBER=923476242709
ATG_TIMEZONE=Asia/Karachi
ATG_POSTS_PER_DAY=3

# Keep false during the three-day validation period. Approve drafts from the CLI.
ATG_AUTO_APPROVE=false

# Phase 1: Telegram official Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_OWNER_CHAT_ID=

# Buffer personal API key. Store this in GitHub Actions secrets, never in Git.
BUFFER_API_KEY=

# Meta Marketing API. Create ads PAUSED first and enforce the total PKR cap.
# Never commit a real access token.
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_AD_ACCOUNT_ID=act_0000000000000000
META_PAGE_ID=0000000000000000
META_LIFETIME_BUDGET_PKR=1000
META_CAMPAIGN_STATUS=PAUSED

# Optional custom database location (default: marketing_agent/data/marketing.db)
# ATG_DATABASE_PATH=C:/secure/path/marketing.db
