{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ai-tool-gems-backlink-agent",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "python_workers",
    "disable_python_external_sdk"
  ],
  "workers_dev": true,
  "account_id": "4f7a087d9199c825cced4aa7b66ee81d",

  "vars": {
    "BACKLINK_AGENT_ENABLED": "false",
    "BACKLINK_AGENT_MODE": "report_only",
    "MAX_VERIFICATIONS_PER_RUN": "25",
    "MAX_DRAFTS_PER_RUN": "5",
    "OWNER_APPROVAL_REQUIRED": "true",
    "ATG_SITE_URL": "https://aitoolgems.tech"
  },

  "triggers": {
    "crons": [
      "0 1,7,13,19 * * *",
      "0 3 * * SUN",
      "*/30 * * * *"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aitoolgems-backlink-agent",
      "database_id": "aitoolgems-backlink-agent-db",
      "migrations_dir": "migrations"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "BACKLINK_QUEUE",
        "queue": "aitoolgems-backlink-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "aitoolgems-backlink-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "aitoolgems-backlink-dlq"
      }
    ]
  },

  "observability": {
    "enabled": true
  },

  "env": {
    "staging": {
      "name": "ai-tool-gems-backlink-agent-staging",
      "vars": {
        "BACKLINK_AGENT_ENABLED": "false",
        "BACKLINK_AGENT_MODE": "report_only",
        "MAX_VERIFICATIONS_PER_RUN": "10",
        "MAX_DRAFTS_PER_RUN": "2",
        "OWNER_APPROVAL_REQUIRED": "true",
        "ATG_SITE_URL": "https://aitoolgems.tech",
        "TELEGRAM_WEBHOOK_SECRET": "test-staging-secret-token-abcdef12345",
        "TELEGRAM_OWNER_CHAT_ID": "987654321",
        "TELEGRAM_OWNER_USER_ID": "987654321"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aitoolgems-backlink-agent-staging",
          "database_id": "d2f1d250-e422-49f5-8965-dee74423c485"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "BACKLINK_QUEUE",
            "queue": "aitoolgems-backlink-jobs-staging"
          }
        ],
        "consumers": [
          {
            "queue": "aitoolgems-backlink-jobs-staging",
            "max_batch_size": 2,
            "max_batch_timeout": 10,
            "max_retries": 2,
            "dead_letter_queue": "aitoolgems-backlink-dlq-staging"
          }
        ]
      }
    }
  }
}
